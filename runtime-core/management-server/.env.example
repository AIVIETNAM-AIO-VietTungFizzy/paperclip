# Management server config
PORT=3004

# Auth: CP pushes entitlements to this server using this token
RUNTIME_SERVICE_TOKEN=your-runtime-service-token-here

# Auth: This server forwards entitlement pushes to Paperclip using this token
CP_SERVICE_TOKEN=your-cp-service-token-here

# Paperclip server URL to forward entitlement pushes to
PAPERCLIP_API_URL=http://localhost:3100

# Control-plane database URL (for demo seeding)
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
# CP_DATABASE_URL=postgres://...

# OCMT data directory — per-user openclaw.json files live under $OCMT_DATA_DIR/$tenant_id/<user-id>/
# OCMT_DATA_DIR=/opt/ocmt/data